#!/bin/bash
# Flow CLI — modular architecture
# Usage: flow <command> [args]
set -euo pipefail

VERSION="0.3.0"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"
CMD_DIR="$(dirname "$SCRIPT_DIR")/commands"
BASE_DIR="$(dirname "$SCRIPT_DIR")"

# ── Source library modules (order matters: ui first, then others) ──
source "$LIB_DIR/ui.sh"
source "$LIB_DIR/platform.sh"
source "$LIB_DIR/deps.sh"
source "$LIB_DIR/conflict.sh"
source "$LIB_DIR/trust.sh"
source "$LIB_DIR/panels.sh"

# ── Global flags ──
OPT_VERBOSE=false
OPT_DRY_RUN=false
OPT_ASSUME_YES=false
OPT_JSON=false
OPT_RESTART=true
OPT_EXTRAS=""
FLOW_BASE_DIR="${BASE_DIR}"

# ── Parse global flags before command ──
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--verbose) OPT_VERBOSE=true; shift ;;
        -y|--yes) OPT_ASSUME_YES=true; shift ;;
        --dry-run) OPT_DRY_RUN=true; shift ;;
        --json) OPT_JSON=true; shift ;;
        --no-restart) OPT_RESTART=false; shift ;;
        --extras) OPT_EXTRAS="all"; shift ;;
        --hypr) HYPWANT=true; shift ;;
        -h|--help) COMMAND="help"; shift; break ;;
        -V|--version) echo "flow $VERSION"; exit 0 ;;
        -*) echo "Unknown flag: $1"; exit 2 ;;
        *) POSITIONAL+=("$1"); shift ;;
    esac
done

# Restore positionals for command dispatch
for arg in "${POSITIONAL[@]+"${POSITIONAL[@]}"}"; do
    set -- "$@" "$arg"
done 2>/dev/null || true

show_help() {
    echo "Flow CLI v$VERSION"
    echo "Usage: flow <command> [args]"
    echo ""
    echo "Commands:"
    echo "  install [tier]   Install dependencies (core/ux/devops)"
    echo "  apply [--extras] Apply configs (--hypr for Hyprland)"
    echo "  update           Update from remote"
    echo "  engine build     Build + install Flow Engine"
    echo "  project detect   Detect project capabilities"
    echo "  trust on|off     Manage per-project trust"
    echo "  suggest [prefix] Query suggestion engine (CLI)"
    echo "  doctor           Health check"
    echo "  status           System status"
}

# ── Dispatch ──
COMMAND="${1:-status}"
shift 2>/dev/null || true

case "$COMMAND" in
    doctor)       source "$CMD_DIR/doctor.sh"; cmd_doctor ;;
    project)      source "$CMD_DIR/project.sh"; cmd_project "$@" ;;
    trust)        source "$CMD_DIR/project.sh"; cmd_trust "$@" ;;
    engine)       source "$CMD_DIR/engine.sh"; cmd_engine "$@" ;;
    suggest)      source "$CMD_DIR/suggest.sh"; cmd_suggest "$@" ;;
    status)       source "$CMD_DIR/status.sh"; cmd_status ;;
    install)      source "$CMD_DIR/install.sh"; cmd_install "$@" ;;
    uninstall)    source "$CMD_DIR/uninstall.sh"; cmd_uninstall ;;
    bench)        source "$CMD_DIR/bench.sh"; cmd_bench ;;
    help)         show_help ;;
    *)
        # try commands dir as fallback
        if [[ -f "$CMD_DIR/$COMMAND.sh" ]]; then
            source "$CMD_DIR/$COMMAND.sh"
            "cmd_$COMMAND" "$@"
        else
            ui_fail "Unknown command" "$COMMAND — run 'flow help'"
            exit 1
        fi
        ;;
esac
